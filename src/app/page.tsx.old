"use client"
import { useState, useEffect } from 'react'
import { getListings, addListing } from '@/lib/db'

export default function Home() {
  const [listings, setListings] = useState<any[]>([])
  const [showPost, setShowPost] = useState(false)
  const [search, setSearch] = useState("")
  const [form, setForm] = useState({title:"",city:"Brampton",province:"ON",area:"",price:"",peopleMin:"",peopleMax:"",description:"",contact:"",email:"",type:"Office"})

  useEffect(()=>{ getListings().then(setListings) },[])

  const filtered = listings.filter((l:any)=>
    l.title.toLowerCase().includes(search.toLowerCase()) ||
    l.city.toLowerCase().includes(search.toLowerCase())
  )

  const handlePost = async()=>{
    if(!form.title ||!form.area ||!form.price) { alert("Fill title, area, price"); return }
    const newListing = {
      id: Date.now().toString(),
      title: form.title,
      city: form.city,
      province: form.province,
      area: parseInt(form.area),
      price: parseInt(form.price),
      peopleMin: parseInt(form.peopleMin)||1,
      peopleMax: parseInt(form.peopleMax)||1,
      description: form.description,
      contact: form.contact,
      email: form.email,
      type: form.type
    }
    await addListing(newListing)
    const updated = await getListings()
    setListings(updated)
    setShowPost(false)
    setForm({title:"",city:"Brampton",province:"ON",area:"",price:"",peopleMin:"",peopleMax:"",description:"",contact:"",email:"",type:"Office"})
  }

  return (
    <div className="min-h-screen bg-gray-50 p-4">
      <div className="max-w-6xl mx-auto">
        <div className="flex justify-between items-center mb-6 bg-white p-4 rounded shadow">
          <h1 className="text-2xl font-bold">Find Brampton Commercial Space</h1>
          <button onClick={()=>setShowPost(true)} className="bg-blue-600 text-white px-4 py-2 rounded">+ Post</button>
        </div>

        <input
          placeholder="Search Brampton, Office, Retail..."
          value={search}
          onChange={e=>setSearch(e.target.value)}
          className="w-full p-3 mb-6 border rounded shadow"
        />

        <div className="grid md:grid-cols-3 gap-4">
          {filtered.map((l:any)=>(
            <div key={l.id} className="bg-white p-4 rounded shadow border">
              {l.area >= 10000 && <span className="bg-yellow-400 text-xs px-2 py-1 rounded font-bold">10K+ sqft</span>}
              <h3 className="font-bold text-lg mt-2">{l.title}</h3>
              <p className="text-gray-600">{l.city}, {l.province} • {l.area} sqft</p>
              <p className="text-blue-600 font-bold">${l.price}/mo</p>
              <p className="text-sm">{l.peopleMin}-{l.peopleMax} people • {l.type}</p>
              <p className="text-xs mt-2 text-gray-500">{l.description}</p>
            </div>
          ))}
        </div>

        {filtered.length===0 && <p className="text-center mt-10 text-gray-500">No listings found. Post first one!</p>}

        {showPost && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
            <div className="bg-white p-6 rounded max-w-md w-full max-h- overflow-auto">
              <h2 className="text-xl font-bold mb-4">Post Commercial Space</h2>
              <input placeholder="Title" value={form.title} onChange={e=>setForm({...form,title:e.target.value})} className="w-full p-2 mb-2 border rounded"/>
              <div className="flex gap-2 mb-2">
                <input placeholder="City" value={form.city} onChange={e=>setForm({...form,city:e.target.value})} className="w-1/2 p-2 border rounded"/>
                <input placeholder="Province" value={form.province} onChange={e=>setForm({...form,province:e.target.value})} className="w-1/2 p-2 border rounded"/>
              </div>
              <div className="flex gap-2 mb-2">
                <input placeholder="Area sqft (12000 for 10K+ badge)" type="number" value={form.area} onChange={e=>setForm({...form,area:e.target.value})} className="w-1/2 p-2 border rounded"/>
                <input placeholder="Price /mo" type="number" value={form.price} onChange={e=>setForm({...form,price:e.target.value})} className="w-1/2 p-2 border rounded"/>
              </div>
              <div className="flex gap-2 mb-2">
                <input placeholder="Min people" type="number" value={form.peopleMin} onChange={e=>setForm({...form,peopleMin:e.target.value})} className="w-1/2 p-2 border rounded"/>
                <input placeholder="Max people" type="number" value={form.peopleMax} onChange={e=>setForm({...form,peopleMax:e.target.value})} className="w-1/2 p-2 border rounded"/>
              </div>
              <select value={form.type} onChange={e=>setForm({...form,type:e.target.value})} className="w-full p-2 mb-2 border rounded">
                <option>Office</option><option>Retail</option><option>Warehouse</option><option>Industrial</option>
              </select>
              <textarea placeholder="Description" value={form.description} onChange={e=>setForm({...form,description:e.target.value})} className="w-full p-2 mb-2 border rounded"/>
              <input placeholder="Contact Name" value={form.contact} onChange={e=>setForm({...form,contact:e.target.value})} className="w-full p-2 mb-2 border rounded"/>
              <input placeholder="Email" value={form.email} onChange={e=>setForm({...form,email:e.target.value})} className="w-full p-2 mb-4 border rounded"/>
              <div className="flex gap-2">
                <button onClick={handlePost} className="flex-1 bg-blue-600 text-white p-2 rounded">Post Listing</button>
                <button onClick={()=>setShowPost(false)} className="flex-1 bg-gray-300 p-2 rounded">Cancel</button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
